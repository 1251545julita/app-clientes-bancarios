<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>ar.edu.utn.diplomatura</groupId>
    <artifactId>app-clientes-bancarios</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>app-clientes-bancarios</name>
    <description>
        Ejemplos ejecutables de Programación Orientada a Objetos - Herencia y Modelado de Clases.
        Diplomatura en Desarrollo de Software FinTech: IA y Microservicios (UTN / Codeki).
        Java puro: sin Spring Boot y sin base de datos.
    </description>

    <properties>
        <!-- Java 21, la versión que se usa en toda la diplomatura. -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- UTF-8 para que los acentos de los comentarios y de los textos
             se compilen bien en cualquier sistema operativo. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        No hay una sección <dependencies> a propósito: todo lo que usa este
        proyecto (clases, objetos, herencia, interfaces) es parte del lenguaje.
        No hace falta ninguna librería externa.
    -->

</project>
